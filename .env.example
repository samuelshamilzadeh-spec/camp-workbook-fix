# Copy to .env for local script runs (scripts/*.ts read this via `node --env-file`).
# For `func start`, put the same values under "Values" in local.settings.json.
# NEVER commit the filled-in copy.

# --- Entra app registration (app-only / client credentials) ---
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=

# In Azure, prefer a user-assigned managed identity and omit the secret:
# AZURE_USE_MANAGED_IDENTITY=true
# AZURE_MANAGED_IDENTITY_CLIENT_ID=

# --- Target workbook ---
# Get all of these in one step by opening the workbook in a browser, copying the
# address bar URL, and running:
#
#   npm run resolve -- "<that URL>"
#
# Drive holding the workbook. Preferred: this addresses the file wherever it
# lives, including a non-default document library, a Teams channel, or OneDrive.
GRAPH_DRIVE_ID=
# The workbook's driveItem id.
GRAPH_ITEM_ID=
# Optional. Only used if GRAPH_DRIVE_ID is empty, and then only finds the file if
# it sits in the site's DEFAULT document library.
GRAPH_SITE_ID=

# --- Run mode ---
# Phase gate. Nothing above the configured phase is ever applied. See README.
SYNC_PHASE=1
# Dry run stays available after phase 1. true = compute and log a plan, write nothing.
SYNC_DRY_RUN=true
# Must be flipped to true only after the layout in src/config.ts has been checked
# against the real workbook. Any write path refuses to run while this is false.
SYNC_LAYOUT_VERIFIED=false

# --- Scan coverage ---
# One camp season is roughly 60 daily sheets (a week of June, all July, most of
# August), and 60 concurrent reads fit inside a cycle. So the default is to read
# EVERY daily sheet EVERY cycle: no rotation, no staleness.
#
# At or below this many daily sheets, scan everything. Above it, fall back to the
# hot/cold tiering described below — which is what happens once the workbook
# accumulates more than one season.
SYNC_MAX_SHEETS_PER_CYCLE=90
# Concurrent Graph reads. This is what makes a full scan fit in five seconds;
# sequential reads of 60 sheets would take 12-24s. Raise with care: too high and
# Graph starts returning 429. Capped at 16 for that reason.
SYNC_READ_CONCURRENCY=8
#
# Every setting in this section must be a whole number in range, and startup
# fails if one is not. A typo used to produce NaN, which does not throw — it
# quietly switched the scan to tiering and then read none of the cold pool, so
# sheets outside the hot window stopped reconciling with nothing in the log.
#
# --- Tiering (only used above the threshold above) ---
#
# Days back from today, read every cycle.
SYNC_HOT_DAYS_BACK=7
# Days FORWARD from today, read every cycle. The office creates daily sheets in
# advance, so this must cover how far ahead they work. Too low and a sheet
# created early sits unscanned until its date comes round.
SYNC_HOT_DAYS_FORWARD=14
# Sheets pulled from the rotation each cycle. Raising it shortens the time to a
# full sweep and raises the per-cycle Graph call count one-for-one.
SYNC_COLD_BATCH_SIZE=10

# --- Checkpoint / loop-guard state ---
# Omit locally to fall back to an on-disk store under .state/.
AZURE_STORAGE_CONNECTION_STRING=
SYNC_STATE_CONTAINER=camp-sync-state
