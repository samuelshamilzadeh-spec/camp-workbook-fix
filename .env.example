# Copy to .env for local script runs (scripts/*.ts read this via `node --env-file`).
# For `func start`, put the same values under "Values" in local.settings.json.
# NEVER commit the filled-in copy.

# --- Entra app registration (app-only / client credentials) ---
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=

# In Azure, prefer a user-assigned managed identity and omit the secret:
# AZURE_USE_MANAGED_IDENTITY=true
# AZURE_MANAGED_IDENTITY_CLIENT_ID=

# --- Target workbook ---
# SharePoint site id of the site holding the workbook.
# Get it with: GET /sites/{hostname}:/sites/{site-path}
GRAPH_SITE_ID=contoso.sharepoint.com,00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000
# driveItem id of the workbook itself.
# Get it with: GET /sites/{siteId}/drive/root:/path/to/Workbook.xlsx
GRAPH_ITEM_ID=

# --- Run mode ---
# Phase gate. Nothing above the configured phase is ever applied. See README.
SYNC_PHASE=1
# Dry run stays available after phase 1. true = compute and log a plan, write nothing.
SYNC_DRY_RUN=true
# Must be flipped to true only after the layout in src/config.ts has been checked
# against the real workbook. Any write path refuses to run while this is false.
SYNC_LAYOUT_VERIFIED=false

# --- Bounded scan ---
# How many of the most recent daily sheets to scan each cycle, on top of any
# sheet referenced by an existing queue row.
SYNC_RECENT_SHEET_COUNT=5

# --- Checkpoint / loop-guard state ---
# Omit locally to fall back to an on-disk store under .state/.
AZURE_STORAGE_CONNECTION_STRING=
SYNC_STATE_CONTAINER=camp-sync-state
